# 공유 비밀번호 (앱 접속용). 원하는 값으로 바꿔서 .env.local 로 복사하세요.
SITE_PASSWORD=changeme

# 관리자 비밀번호 (참가자 풀 관리 / 과거 누적기록 입력 화면 접근용).
# SITE_PASSWORD와 별개의 값으로 설정하세요.
ADMIN_PASSWORD=changeme-admin

# Supabase 프로젝트 정보 (필수 — 로컬 개발과 프로덕션 모두 이 값으로 Supabase에
# 접속합니다). Supabase 대시보드 → 프로젝트 선택 → Settings → API에서 확인하세요.
#   SUPABASE_URL              = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" 비밀 키 (anon key 아님!)
# 서비스 롤 키는 RLS(Row Level Security)를 완전히 우회하는 매우 민감한 값입니다.
# 절대 커밋하지 말고, 브라우저로 전달되는 코드에서 참조하지 마세요 — 이 앱에서는
# src/lib/supabase.ts(서버 전용)에서만 사용합니다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=changeme-service-role-key

# 예전 저장소(Vercel Blob)의 토큰 — v2.11부터 앱 코드는 더 이상 이 값을 쓰지
# 않습니다. scripts/migrate-to-supabase.ts로 기존 프로덕션 데이터를 Supabase로
# 옮길 때만 한 번 필요합니다. 마이그레이션을 마쳤다면 이 줄과 Vercel 프로젝트의
# 환경변수에서 제거해도 됩니다.
# BLOB_READ_WRITE_TOKEN=
